# =============================================================================
# AskWise — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha com seus valores:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# OpenAI API
# -----------------------------------------------------------------------------
# Sua API key da OpenAI (obrigatório)
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Modelo para gerar embeddings (vetores de texto)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Modelo para gerar respostas do chat
OPENAI_CHAT_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Qdrant (Vector Store)
# -----------------------------------------------------------------------------
# Host e porta do Qdrant (suba com: docker compose up -d)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Nome da collection onde os vetores serão armazenados
QDRANT_COLLECTION=askwise

# -----------------------------------------------------------------------------
# Servidor HTTP (Upload API)
# -----------------------------------------------------------------------------
# Porta do servidor de upload
SERVER_PORT=8484

# Tamanho máximo de arquivo em bytes (10MB = 10485760)
MAX_FILE_SIZE=10485760

# -----------------------------------------------------------------------------
# RAG Pipeline
# -----------------------------------------------------------------------------
# Tamanho de cada chunk em tokens (~500 tokens = ~375 palavras)
RAG_CHUNK_SIZE=500

# Overlap entre chunks consecutivos em tokens
RAG_CHUNK_OVERLAP=50

# Quantidade de chunks retornados na busca (top-K)
RAG_TOP_K=5

# Score mínimo de similaridade (0.0 a 1.0)
RAG_SCORE_THRESHOLD=0.5

# -----------------------------------------------------------------------------
# SQLite (Metadados)
# -----------------------------------------------------------------------------
# Caminho para o arquivo do banco SQLite
SQLITE_PATH=./data/askwise.db
